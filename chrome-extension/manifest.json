{
  "manifest_version": 3,
  "name": "DynaClip Popup",
  "version": "0.1.0",
  "description": "Session-only clipboard history in a single Chrome popup.",
  "permissions": [
    "storage",
    "clipboardRead"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Open DynaClip",
    "default_popup": "sidepanel.html"
  }
}
